# ─── Python ────────────────────────────────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Flet build and distribution ───────────────────────────────────────
build/
dist/
.flet/
*.spec

# ─── Secrets. The application never saves an API key, but block anything
#     that could end up holding one anyway. ───────────────────────────
.env
.env.*
*.key
*.pem
secrets.json
credentials.json

# ─── Research data: transcripts, exports, recordings.
#     These must NEVER be published to GitHub. ────────────────────────
*.transcript.json
*.docx
~$*.docx
temp_audio/
transcripts/
Recordings/

# Source audio and video files
*.m4a
*.wav
*.mp3
*.mp4
*.aac
*.flac
*.webm
*.mkv
*.mov
*.ogg
*.opus
*.wma

# ─── Local shortcuts: they hold absolute paths from one machine ────────
*.lnk
*.bat

# ─── Editors and operating systems ─────────────────────────────────────
.idea/
.vscode/
*.log
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ─── Exceptions: these MUST reach GitHub ──────────────────────────────
!assets/bin/windows/SOURCE-FFMPEG.txt
!assets/icon.svg

# FFmpeg is fetched, not committed. The pair is ~194 MB and changes only when
# tools_fetch_ffmpeg.py pins a new version; keeping it in the repository would spend the
# Git LFS bandwidth allowance on every clone and every CI run. Run
# `python tools_fetch_ffmpeg.py` once after cloning; CI runs it before every build.
assets/bin/windows/ffmpeg.exe
assets/bin/windows/ffprobe.exe
assets/bin/windows/LICENSE-FFMPEG.txt
